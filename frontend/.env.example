# Apenas NOMES de variáveis, como na raiz do repositório.
# Copie para .env.local (ignorado pelo Git) e preencha.

# Onde o gateway responde. Sem valor, o cliente cai em http://localhost:8080.
# ATENÇÃO: o gateway só aceita chamadas de uma origem que esteja em
# CORS_ALLOWED_ORIGINS — e o padrão dele é http://localhost:5173, que é a porta
# fixa deste Vite.
VITE_API_BASE_URL=
